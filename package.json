{
  "name": "fafo-nation-hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "check:routes": "node scripts/check-routes.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run prisma:generate && npm run lint && npm run check:routes && npm run test:unit && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@workos-inc/authkit-nextjs": "4.3.1",
    "@workos-inc/node": "10.9.0",
    "maplibre-gl": "^5.6.1",
    "next": "16.3.0",
    "pmtiles": "4.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.1"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
